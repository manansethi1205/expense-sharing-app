            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Group settled\", function () { pm.expect(pm.response.json().is_settled).to.eql(true); pm.expect(pm.response.json().balances).to.have.lengthOf(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Record unequal expense",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/groups/{{group_id}}/expenses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paid_by\": {{mohit_id}},\n  \"amount\": \"1000.00\",\n  \"description\": \"Activities\",\n  \"split_type\": \"custom\",\n  \"splits\": [\n    {\n      \"user_id\": {{mohit_id}},\n      \"amount\": \"500.00\"\n    },\n    {\n      \"user_id\": {{rahul_id}},\n      \"amount\": \"300.00\"\n    },\n    {\n      \"user_id\": {{ankit_id}},\n      \"amount\": \"200.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
