            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_user_id\": {{rahul_id}},\n  \"to_user_id\": {{mohit_id}},\n  \"amount\": \"400.00\",\n  \"mode\": \"direct\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
