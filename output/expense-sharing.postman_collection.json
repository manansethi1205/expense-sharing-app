{
  "info": {
    "name": "Expense Sharing - Complete Assignment Walkthrough",
    "description": "Final assignment walkthrough. Live UI: https://expense-sharing-app-inda.onrender.com/. Import and select Render.postman_environment.json for the hosted API, or Local.postman_environment.json for localhost. Run all 21 requests in order; returned IDs are captured automatically, so this works with existing seed data. Uses a separate dinner-only trip, then demonstrates custom splits, settlements, categories, search and analytics. All records are synthetic; payments are recorded, not executed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Mohit",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/users",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mohit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"mohit_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
