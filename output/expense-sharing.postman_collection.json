    {
      "name": "Record equal dinner",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/groups/{{group_id}}/expenses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paid_by\": {{mohit_id}},\n  \"amount\": \"1200.00\",\n  \"description\": \"Dinner\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"expense_id\", pm.response.json().id);",
              "pm.test(\"Three equal shares\", function () { pm.expect(pm.response.json().shares.map(s => s.amount)).to.eql([\"400.00\",\"400.00\",\"400.00\"]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "View direct balances",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/groups/{{group_id}}/balances",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Two debts\", function () { pm.expect(pm.response.json().balances).to.have.lengthOf(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Personal spending versus paid",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/users/{{mohit_id}}/analytics",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Consumption differs from amount paid\", function () { pm.expect(pm.response.json().totals.spending).to.eql(\"400.00\"); pm.expect(pm.response.json().totals.paid).to.eql(\"1200.00\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Goa",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/search?q=Goa&group_id={{group_id}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Preview exact settlements",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/groups/{{group_id}}/settlement-suggestions",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Exact two-payment plan\", function () { pm.expect(pm.response.json().optimality_guaranteed).to.eql(true); pm.expect(pm.response.json().transaction_count).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Record Rahul reimbursement",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/groups/{{group_id}}/settlements",
        "header": [
